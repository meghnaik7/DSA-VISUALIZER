# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── AI Provider ───────────────────────────────────────────────────────────────
# Set to "openai" or "gemini"
AI_PROVIDER=openai

# OpenAI — required if AI_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Google Gemini — required if AI_PROVIDER=gemini
GEMINI_API_KEY=...

# Model to use (e.g. gpt-4o-mini, gpt-4o, gemini-1.5-flash)
AI_MODEL=gpt-4o-mini

# Timeout per AI call in milliseconds
AI_TIMEOUT_MS=30000

# Max retries on transient failures (rate limits, 5xx)
AI_MAX_RETRIES=2

# ── Request limits ─────────────────────────────────────────────────────────────
MAX_PAYLOAD_BYTES=65536

# ── Service authentication ────────────────────────────────────────────────────
# Set a shared secret for Spring-to-Node calls; leave empty to disable in dev
SERVICE_SECRET=

# ── Spring Backend ────────────────────────────────────────────────────────────
SPRING_BASE_URL=http://localhost:8080
